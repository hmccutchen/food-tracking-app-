#!/bin/bash -e

# If running the rails server then create or migrate existing database, and
# load the reference data (idempotent: taxonomy, prep methods, descriptors,
# and the nurse account when NURSE_PASSWORD is set).
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails db:seed
fi

exec "${@}"
