<% content_for :title, "Account" %>
<h1>Account</h1>
<p class="help">Signed in as <%= current_user.email %></p>

<%= form_with model: current_user, url: account_path, method: :patch, id: "change_password", class: "panel form" do |form| %>
  <h2>Change password</h2>
  <% if current_user.errors.any? %>
    <div class="flash-alert" role="alert">
      <ul>
        <% current_user.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
      </ul>
    </div>
  <% end %>
  <div class="field">
    <%= form.label :current_password %>
    <%= form.password_field :current_password, required: true, autocomplete: "current-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72,
          aria: { describedby: "password_help" } %>
    <small id="password_help">12 to 72 characters.</small>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Repeat new password" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="actions"><%= form.submit "Change password" %></div>
<% end %>
