<% content_for :title, "Edit preparation note" %>
<h1>Edit preparation note: <%= @prep_method.name_was.presence || @prep_method.name %></h1>

<div class="panel">
<%= form_with model: @prep_method, class: "form" do |form| %>
  <%= render "shared/errors", record: @prep_method %>

  <div class="field">
    <%= form.label :name, "Method name" %>
    <%= form.text_field :name, required: true %>
  </div>
  <div class="field" data-controller="tags">
    <%= form.label :keywords_text, "Keywords (whole words only)" %>
    <%= form.text_area :keywords_text, rows: 2, aria: { describedby: "prep_keywords_help" } %>
    <small id="prep_keywords_help">Press Enter or type a comma after each one.</small>
  </div>
  <div class="field">
    <%= form.label :risk, "Why it's a risk" %>
    <%= form.text_area :risk, rows: 2, required: true %>
  </div>
  <div class="field">
    <%= form.label :lower_risk_method, "Lower-risk method" %>
    <%= form.text_field :lower_risk_method, required: true %>
  </div>
  <div class="field">
    <%= form.label :caveat, "Caveat (shown after the lower-risk method)" %>
    <%= form.text_field :caveat, required: true %>
  </div>
  <div class="field">
    <%= form.label :risk_node_ids, "Risk ingredients (hold Ctrl or Cmd to pick several)" %>
    <%= form.collection_select :risk_node_ids, TaxonomyNode.order(:name), :id, :name, {},
          multiple: true, size: 12 %>
  </div>
  <div class="field field-narrow">
    <%= form.label :position, "Order" %>
    <%= form.number_field :position, min: 0 %>
  </div>
  <div class="check-row">
    <%= form.check_box :active %>
    <%= form.label :active, "Show this note" %>
  </div>
  <div class="actions"><%= form.submit "Save" %> <%= link_to "Cancel", prep_methods_path, class: "btn btn-secondary" %></div>
<% end %>
</div>
