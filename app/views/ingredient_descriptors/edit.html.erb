<% content_for :title, "Edit descriptor word" %>
<h1>Edit descriptor word: <%= @descriptor.word_was.presence || @descriptor.word %></h1>

<div class="panel">
<%= form_with model: @descriptor, class: "form" do |form| %>
  <%= render "shared/errors", record: @descriptor %>
  <div class="field">
    <%= form.label :word, "Word" %>
    <%= form.text_field :word, required: true %>
  </div>
  <div class="check-row">
    <%= form.check_box :active %>
    <%= form.label :active, "Use this word" %>
  </div>
  <div class="actions"><%= form.submit "Save" %> <%= link_to "Cancel", ingredient_descriptors_path, class: "btn btn-secondary" %></div>
<% end %>
</div>
