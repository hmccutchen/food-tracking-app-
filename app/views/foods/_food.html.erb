<li id="<%= dom_id(food) %>" class="food">
  <strong class="food-name"><%= food.description %></strong>
  <span class="item-meta food-source"><%= food.source_label %><% if food.category.present? %> · <%= food.category %><% end %>
  · imported <%= food.imported_at.strftime("%B %-d, %Y") %></span>
  <span class="food-link"><%= food_link_summary(food) %></span>
  <% if food.ingredients_text.present? %>
    <span class="food-ingredients">Ingredients: <%= food.ingredients_text %></span>
  <% else %>
    <em class="food-ingredients muted">No ingredient list on this record.</em>
  <% end %>
</li>
