<% content_for :title, "Who's eating?" %>
<h1>Who's eating?</h1>

<% if @patients.empty? %>
  <p>No patients yet. <%= link_to "Add a patient", new_patient_path %> first.</p>
<% else %>
  <%= form_with url: group_path, method: :get, id: "group_selection",
        data: { turbo_frame: "avoid_list", turbo_action: "advance", controller: "auto-submit" } do |form| %>
    <fieldset>
      <legend>Pick the patients eating together</legend>
      <%# Always sent, so clearing every box is remembered as "nobody". %>
      <%= hidden_field_tag "patient_ids[]", "", id: nil %>
      <ul class="patient-picker">
        <% @patients.each do |patient| %>
          <li>
            <%= check_box_tag "patient_ids[]", patient.id, @selected.include?(patient), id: dom_id(patient, :select),
                  data: { action: "change->auto-submit#submit" } %>
            <%= label_tag dom_id(patient, :select), patient.display_name %>
          </li>
        <% end %>
      </ul>
    </fieldset>
    <%= form.submit "Update", name: nil, data: { auto_submit_target: "button" } %>
  <% end %>
<% end %>

<%= turbo_frame_tag "avoid_list" do %>
  <p id="list_built_at" class="list-built-at">
    List built at <%= time_tag @avoid_list.built_at, @avoid_list.built_at.to_fs(:short) %>
  </p>
  <%= render "groups/avoid_list", avoid_list: @avoid_list %>

  <% if @selected.any? %>
    <section id="check_ingredients" aria-labelledby="check_ingredients_heading">
      <h2 id="check_ingredients_heading">Check ingredients</h2>
      <%= form_with url: check_group_path, id: "check_ingredients_form" do |form| %>
        <% @selected.each do |patient| %>
          <%= hidden_field_tag "patient_ids[]", patient.id, id: nil %>
        <% end %>
        <p>
          <%= label_tag :ingredients, "Ingredients (one per line, or separated by commas)" %><br>
          <%= text_area_tag :ingredients, @ingredients_text, rows: 4, data: { turbo_permanent: true } %>
        </p>
        <p><%= form.submit "Check", name: nil %></p>
      <% end %>
      <div id="evaluation_result" aria-live="polite">
        <% if @result %>
          <%= render "evaluations/result", result: @result, patients: @names, prep_notes: @prep_notes,
                cross_contact: @cross_contact %>
        <% end %>
      </div>
    </section>

    <section id="suggest_meals" aria-labelledby="suggest_meals_heading">
      <h2 id="suggest_meals_heading">Suggest meals</h2>
      <p>Meal ideas come from your AI provider. Every one is checked against these patients' restrictions here,
        and meals with a conflict are set aside. Only restriction terms are sent, never names.</p>
      <%= form_with url: meal_requests_path, id: "suggest_meals_form" do |form| %>
        <% @selected.each do |patient| %>
          <%= hidden_field_tag "patient_ids[]", patient.id, id: nil %>
        <% end %>
        <p>
          <%= label_tag :request_text, "What kind of meal? (optional, e.g. \"dinner, soft foods\")" %><br>
          <%= text_area_tag :request_text, nil, rows: 2, maxlength: 500 %>
        </p>
        <p><%= form.submit "Suggest meals", name: nil %></p>
      <% end %>
    </section>
  <% end %>

  <% if @selected.any? || @has_meal_requests %>
    <%# Loaded separately so this page's HTML (which the service worker may
        save for offline use) never holds meal results. %>
    <%= turbo_frame_tag "recent_meal_requests_frame", src: meal_requests_path do %>
      <p>Loading recent meal suggestions…</p>
    <% end %>
  <% end %>
<% end %>
