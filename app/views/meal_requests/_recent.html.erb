<%# locals: (meal_requests:) %>
<section id="recent_meal_requests" class="recent-meals" aria-labelledby="recent_meal_requests_heading">
  <h2 id="recent_meal_requests_heading">Recent meal suggestions</h2>
  <div id="meal_requests">
    <% meal_requests.each do |meal_request| %>
      <%= render "meal_requests/meal_request", meal_request: %>
    <% end %>
  </div>
  <% if meal_requests.empty? %>
    <p id="meal_requests_empty" class="empty-state">No meal suggestions yet.</p>
  <% end %>
</section>
