<%# Shared by the inline add form and the inline edit form. %>
<% frame_id = restriction.new_record? ? "new_restriction" : dom_id(restriction) %>
<%= turbo_frame_tag frame_id do %>
  <%= form_with model: [ patient, restriction ], id: "#{frame_id}_form", class: "form restriction-form" do |form| %>
    <%= render "shared/errors", record: restriction %>

    <div class="field">
      <%= form.label :kind, "Kind", for: "#{frame_id}_kind" %>
      <%= form.select :kind, Restriction::KIND_LABELS.map { |kind, (_, option)| [ option, kind ] },
            {}, id: "#{frame_id}_kind" %>
    </div>

    <div class="field">
      <%= form.label :term, "What (in your words)", for: "#{frame_id}_term" %>
      <%= form.text_field :term, id: "#{frame_id}_term", required: true, autocomplete: "off" %>
    </div>

    <div class="field">
      <%= form.label :note, "Note (optional)", for: "#{frame_id}_note" %>
      <%= form.text_field :note, id: "#{frame_id}_note", autocomplete: "off" %>
    </div>

    <div class="field">
      <%= form.label :manual_node_id, "Match to (optional)", for: "#{frame_id}_manual_node_id" %>
      <%= form.collection_select :manual_node_id, TaxonomyNode.order(:name), :id, :name,
            { include_blank: "Match automatically" }, id: "#{frame_id}_manual_node_id",
            aria: { describedby: "#{frame_id}_match_help" } %>
      <small id="<%= frame_id %>_match_help">
        "Match automatically" looks up what you typed in the app's food list: the exact name, another name it
        knows ("no nuts" → tree nut), or a close spelling (marked "please check"). If nothing fits, it shows as
        "not recognized" and only ingredients with those exact words are flagged. Pick an item here to choose the
        match yourself.
      </small>
    </div>

    <div class="actions">
      <%= form.submit restriction.new_record? ? "Add restriction" : "Save restriction" %>
      <% unless restriction.new_record? %>
        <%= link_to "Cancel", patient_path(patient), class: "btn btn-secondary" %>
      <% end %>
    </div>
  <% end %>
<% end %>
