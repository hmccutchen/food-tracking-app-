<li class="restriction">
  <%= turbo_frame_tag dom_id(restriction) do %>
    <div class="restriction-body">
      <strong class="restriction-term"><%= restriction.term %></strong>
      <span class="match match-<%= restriction.match_type %>">(<%= restriction.match_reason %>)</span>
      <% if restriction.note.present? %>
        <small class="restriction-note"><%= restriction.note %></small>
      <% end %>
    </div>
    <div class="restriction-actions">
      <%= link_to "Edit", edit_patient_restriction_path(restriction.patient, restriction), class: "btn btn-secondary btn-small", aria: { label: "Edit #{restriction.term}" } %>
      <%= button_to "Remove", patient_restriction_path(restriction.patient, restriction), method: :delete,
            class: "btn-danger btn-small", aria: { label: "Remove #{restriction.term}" },
            form: { data: { turbo_confirm: "Remove #{restriction.term}?" } } %>
    </div>
  <% end %>
</li>
