<% content_for :title, "Patients" %>
<header class="page-header">
  <h1>Patients</h1>
  <p><%= link_to "Add a patient", new_patient_path, class: "btn" %></p>
</header>

<% if @patients.empty? %>
  <p class="empty-state">No patients yet.</p>
<% else %>
  <ul id="patients" class="item-list links">
    <% @patients.each do |patient| %>
      <li id="<%= dom_id(patient) %>"><%= link_to patient.display_name, patient %></li>
    <% end %>
  </ul>
<% end %>
