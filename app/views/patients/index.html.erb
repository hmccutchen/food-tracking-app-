<% content_for :title, "Patients" %>
<h1>Patients</h1>

<p><%= link_to "Add a patient", new_patient_path %></p>

<% if @patients.empty? %>
  <p>No patients yet.</p>
<% else %>
  <ul id="patients">
    <% @patients.each do |patient| %>
      <li id="<%= dom_id(patient) %>"><%= link_to patient.display_name, patient %></li>
    <% end %>
  </ul>
<% end %>
