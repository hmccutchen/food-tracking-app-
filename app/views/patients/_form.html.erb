<%= form_with model: patient do |form| %>
  <%= render "shared/errors", record: patient %>

  <p>
    <%= form.label :display_name, "Name" %><br>
    <%= form.text_field :display_name, required: true, autocomplete: "off" %>
  </p>

  <p>
    <%= form.label :notes %><br>
    <%= form.text_area :notes, rows: 4, cols: 40 %>
  </p>

  <p><%= form.submit %></p>
<% end %>
