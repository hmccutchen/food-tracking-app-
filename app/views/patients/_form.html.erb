<%= form_with model: patient, class: "form" do |form| %>
  <%= render "shared/errors", record: patient %>

  <div class="field">
    <%= form.label :display_name, "Name" %>
    <%= form.text_field :display_name, required: true, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= form.label :notes %>
    <%= form.text_area :notes, rows: 4, cols: 40 %>
  </div>

  <div class="actions"><%= form.submit %></div>
<% end %>
