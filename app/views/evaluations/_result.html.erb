<%# Reusable result card body (M11 meal cards render it too). result is an
    Evaluation::GroupResult; patients maps patient_id to a display name or Patient. %>
<%# locals: (result:, patients: {}) %>
<div class="evaluation-result" data-tier="<%= result.tier %>">
  <% if result.stale? %>
    <p class="stale" role="alert">Out of date — re-check</p>
  <% end %>
  <p class="overall">Overall: <%= tier_badge(result.tier) %></p>
  <% if result.patient_results.empty? %>
    <p><%= result.summary %></p>
  <% end %>
  <% if result.missing_patient_ids.any? %>
    <p><%= pluralize(result.missing_patient_ids.size, "selected patient") %> no longer on file.</p>
  <% end %>

  <% result.patient_results.each do |patient_result| %>
    <section class="patient-result" data-tier="<%= patient_result.tier %>">
      <h3>
        <%= evaluation_patient_name(patients, patient_result.patient_id) %>:
        <%= tier_badge(patient_result.tier) %>
      </h3>
      <% if patient_result.active_flags.any? %>
        <ul class="flags">
          <% patient_result.active_flags.each do |flag| %>
            <li data-tier="<%= flag.tier %>"><%= tier_label(flag.tier) %>: <%= flag.reason %></li>
          <% end %>
        </ul>
      <% end %>
      <% if patient_result.overridden_flags.any? %>
        <div class="marked-ok">
          <p>You marked this OK</p>
          <ul>
            <% patient_result.overridden_flags.each do |flag| %>
              <li><%= flag.reason %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </section>
  <% end %>
</div>
