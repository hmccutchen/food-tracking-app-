<% content_for :title, @item.name %>
<% node = @item.node %>
<h1>Custom item: <%= node.name %></h1>

<dl>
  <dt>A kind of</dt>
  <dd><%= node.parent&.name || "—" %></dd>
  <dt>Other names</dt>
  <dd><%= node.aliases.map(&:term).sort.to_sentence.presence || "—" %></dd>
  <dt>Ingredients</dt>
  <dd><%= node.ingredients_text.presence || "—" %></dd>
  <dt>Restrictions on these also cover it</dt>
  <dd id="covered_by"><%= node.groups.order(:name).map(&:name).to_sentence.presence || "—" %></dd>
</dl>
<% unrecognized = @item.unrecognized_ingredients %>
<% if unrecognized.any? %>
  <p class="unrecognized">Not recognized in the ingredients: <%= unrecognized.to_sentence %>.
    These are not linked to any restriction.</p>
<% end %>

<p>
  <%= link_to "Edit", edit_custom_item_path(@item) %>
  · <%= link_to "All custom items", custom_items_path %>
  · <%= link_to "Who's eating", group_path %>
</p>

<section aria-labelledby="marks_heading">
  <h2 id="marks_heading">Who can have it?</h2>
  <% if @patients.empty? %>
    <p>No patients yet.</p>
  <% else %>
    <p>A "cannot" always wins. A "can" never silences an allergy.</p>
    <%= form_with url: marks_custom_item_path(@item), method: :patch, id: "marks_form" do %>
      <table>
        <thead><tr><th>Patient</th><th>Not set</th><th>Can have</th><th>Cannot have</th></tr></thead>
        <tbody>
          <% @patients.each do |patient| %>
            <% current = @marks[patient.id] %>
            <tr>
              <th scope="row"><%= patient.display_name %></th>
              <% [ [ "", "Not set" ], [ "can", "Can have" ], [ "cannot", "Cannot have" ] ].each do |value, label| %>
                <td>
                  <%= radio_button_tag "marks[#{patient.id}]", value, current.to_s == value,
                        id: dom_id(patient, "mark_#{value.presence || 'none'}"),
                        "aria-label": "#{label}: #{patient.display_name}" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
      <p><%= submit_tag "Save", name: nil %></p>
    <% end %>
  <% end %>
</section>

<%= button_to "Delete custom item", custom_item_path(@item), method: :delete,
      data: { turbo_confirm: "Delete #{node.name}? Restrictions that use it will match by text only." } %>
